# Copy to .env.local and fill in. NEVER commit real values.
# On Vercel, set these in Project Settings > Environment Variables.

# --- Instantly (live data) ---
# Instantly > Settings > Integrations > API Keys. Read-only scope (all:read) is enough.
# Server-only: never rename to NEXT_PUBLIC_*.
INSTANTLY_API_KEY=
# IANA timezone that defines "a day" for ranges and daily charts (default America/New_York).
DASHBOARD_TZ=America/New_York

# --- Login (Supabase Auth; the only thing Supabase is used for) ---
# The one account allowed in. Unset = nobody gets in.
ALLOWED_USER_EMAIL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Lead platform (one Postgres schema "lp"; see docs/LEAD_PLATFORM.md) ---
# Supabase pooler URL or the OVH server. Unset = lead screens show "not connected".
DATABASE_URL=
# One token per agent for /api/ops: tab:<long random>,hermes:<long random>
OPS_AGENT_TOKENS=
# Shared secret Instantly sends as "Authorization: Bearer <secret>" on webhooks
INSTANTLY_WEBHOOK_SECRET=
# Paid verification (used only after you approve a run's cost preview)
MILLIONVERIFIER_API_KEY=
ZEROBOUNCE_API_KEY=

# --- Lead engine runner (on the server that runs engine/cli.ts, not Vercel) ---
# Proxy URLs, used only when a job ticks "Rotate proxies"
ENGINE_PROXIES=
# Free self-hosted search for the owner step (or SERPER_API_KEY, paid; leave unset to stay free)
SEARXNG_URL=
SERPER_API_KEY=
# Agent runners reach the ops API here, with their own token from OPS_AGENT_TOKENS
OPS_URL=
OPS_TOKEN=

# --- Local development only ---
# 1 = skip the login on `npm run dev`. Ignored in production builds and on Vercel.
DASHBOARD_DEV_NO_AUTH=

# --- Legacy Python collector (collector/, not used by the dashboard) ---
# SUPABASE_SERVICE_ROLE_KEY=
# COMPOSIO_API_KEY=
# INSTANTLY_ACCOUNT=
