# ~/.config/dashboard-relay/env   (chmod 600). Values are secrets: never commit the real file.
DASHBOARD_URL=https://marketing-dashboard-xi-five.vercel.app
# Hermes' own dashboard key: /agents/hermes -> API keys -> Create a key (shown once).
DASHBOARD_AGENT_KEY=
# /agents/hermes -> How they hear -> Add a channel -> Wake-up ping (ntfy): the topic shown once.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
# Hermes' Runs API (already on in the leaddesk profile). The key is read from Hermes' .env:
HERMES_API_URL=http://127.0.0.1:8643
HERMES_ENV_FILE=/home/hermes/.hermes/profiles/leaddesk/.env
# WhatsApp pings to Yaakov go through Hermes' own sender (`hermes send -t whatsapp[:to] "text"`).
# `hermes send` already uses the active leaddesk profile (checked Oct 9), so no extra args are needed.
HERMES_BIN=/home/hermes/.local/bin/hermes
HERMES_SEND_ARGS=
# WHATSAPP_DEFAULT_TO=
AGENT_ID=hermes
FALLBACK_POLL_MINUTES=30
