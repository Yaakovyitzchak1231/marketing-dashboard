# ~/.config/tapdash-runner.env   (chmod 600). Values are secrets: never commit the real file.
DASHBOARD_URL=https://marketing-dashboard-xi-five.vercel.app
# The 'system' actor's own ops API key: /agents -> system -> API keys -> Create a key (shown once).
# Never Postgres directly -- the runner only ever talks to the ops API.
RUNNER_KEY=
# A stable id for this runner process (shows up in lp.jobs.locked_by and lp.job_runs.runner).
RUNNER_ID=ovh-runner-1
# How often to check for due jobs.
POLL_SECONDS=15
# How many due jobs to claim per poll (FOR UPDATE SKIP LOCKED makes this safe to raise, or to
# run a second runner process pointed at the same dashboard).
CLAIM_LIMIT=5
