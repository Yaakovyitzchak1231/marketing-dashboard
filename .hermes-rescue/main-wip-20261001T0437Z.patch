diff --git a/tests/delete-honesty.test.ts b/tests/delete-honesty.test.ts
new file mode 100644
index 0000000..9efbce5
--- /dev/null
+++ b/tests/delete-honesty.test.ts
@@ -0,0 +1,87 @@
+import { describe, it, expect, vi, beforeEach } from 'vitest'
+
+// A DELETE that RLS filtered out to zero rows is NOT an error in Postgres: the
+// row is simply invisible, so the statement matches nothing and returns a null
+// error. Before this regression test, all three DELETE routes checked only
+// `error` and therefore answered {"ok": true} for a delete that removed
+// nothing. That is the exact dishonesty the dashboard is not allowed to ship.
+//
+// These tests pin the contract: the route must inspect the returned rows and
+// report a 404 when nothing was removed.
+
+const mockClient = {
+  from: vi.fn(),
+}
+
+vi.mock('@/lib/request-client', () => ({
+  getRequestClient: vi.fn(async () => mockClient),
+}))
+
+function chain(result: { data?: unknown; error?: unknown }) {
+  const built: Record<string, unknown> = {}
+  built.eq = vi.fn(() => built)
+  built.select = vi.fn(() => Promise.resolve(result))
+  built.delete = vi.fn(() => built)
+  built.single = vi.fn(() => Promise.resolve(result))
+  return built
+}
+
+async function callDelete(route: string, id: string) {
+  const mod = await import(route)
+  const req = { cookies: () => new Map() } as never
+  const res = await mod.DELETE(req, { params: Promise.resolve({ id }) })
+  return { status: res.status, body: await res.json() }
+}
+
+beforeEach(() => {
+  vi.clearAllMocks()
+})
+
+describe('DELETE reports honestly when RLS hides the row', () => {
+  it('ideas: 404 when the delete removed zero rows', async () => {
+    mockClient.from = vi.fn(() => chain({ data: [], error: null }))
+    const { status, body } = await callDelete('@/app/api/ideas/[id]/route', 'abc')
+    expect(status).toBe(404)
+    expect(body.error).toMatch(/not found/i)
+    expect(body.ok).toBeUndefined()
+  })
+
+  it('costs: 404 when the delete removed zero rows', async () => {
+    mockClient.from = vi.fn(() => chain({ data: [], error: null }))
+    const { status, body } = await callDelete('@/app/api/costs/[id]/route', 'abc')
+    expect(status).toBe(404)
+    expect(body.error).toMatch(/not found/i)
+  })
+
+  it('angles: 404 when the delete removed zero rows', async () => {
+    mockClient.from = vi.fn(() => chain({ data: [], error: null }))
+    const { status, body } = await callDelete('@/app/api/angles/[id]/route', 'abc')
+    expect(status).toBe(404)
+    expect(body.error).toMatch(/not found/i)
+  })
+
+  it('ideas: 200 ok when a row really was removed', async () => {
+    mockClient.from = vi.fn(() => chain({ data: [{ id: 'abc' }], error: null }))
+    const { status, body } = await callDelete('@/app/api/ideas/[id]/route', 'abc')
+    expect(status).toBe(200)
+    expect(body.ok).toBe(true)
+  })
+
+  it('ideas: 500 when Postgres itself errors', async () => {
+    mockClient.from = vi.fn(() =>
+      chain({ data: null, error: { code: '42501', message: 'permission denied' } }),
+    )
+    const { status } = await callDelete('@/app/api/ideas/[id]/route', 'abc')
+    expect(status).toBe(500)
+  })
+
+  it('the delete chain actually asks for the affected rows', async () => {
+    // Without .select('id') the response carries no row count, so the route
+    // cannot distinguish "deleted one" from "matched nothing".
+    const built = chain({ data: [{ id: 'abc' }], error: null })
+    mockClient.from = vi.fn(() => built)
+    await callDelete('@/app/api/ideas/[id]/route', 'abc')
+    expect(built.delete).toHaveBeenCalled()
+    expect(built.select).toHaveBeenCalledWith('id')
+  })
+})
diff --git a/supabase/migrations/004_security_hardening.sql b/supabase/migrations/004_security_hardening.sql
new file mode 100644
index 0000000..8de913a
--- /dev/null
+++ b/supabase/migrations/004_security_hardening.sql
@@ -0,0 +1,99 @@
+-- 004_security_hardening.sql
+--
+-- Two real exposure findings, verified against the live database on
+-- 2026-10-01. Both widen read access beyond what the repo intended, and both
+-- were contradicted by the live schema rather than by the migrations.
+--
+-- 1. collection_runs was world-readable.
+--    An anonymous request using only the publishable anon key — which ships to
+--    every browser — returned 67 rows from collection_runs, exposing
+--    ran_at, ok, api_calls, campaigns_collected, campaigns_persisted, stages
+--    and errors for every collector. 002's own comment states that reads must
+--    be authenticated-only and warns against USING (true), but neither 002 nor
+--    003 ever enabled RLS on this table or replaced its policies. The four
+--    pre-existing tables were described as already protected; this one was not.
+--
+-- 2. The manual-entry write policies were FOR ALL.
+--    ideas_write / costs_write / angles_write were created FOR ALL TO
+--    authenticated USING (true) WITH CHECK (true). A FOR ALL policy applies its
+--    USING clause to SELECT as well as INSERT/UPDATE/DELETE, and Postgres ORs
+--    multiple permissive policies together rather than intersecting them. So
+--    those policies silently granted every authenticated user a read of every
+--    row, overriding the email-scoped authenticated_read policy that was
+--    created alongside them to restrict reads to Jacob.
+--
+-- Every statement is idempotent.
+
+-- ---------------------------------------------------------------------------
+-- 1. Close the anonymous read on collection_runs.
+--    Enable RLS (no-op if already on) and drop any permissive policy so the
+--    only remaining path is an authenticated, email-scoped read. Collector
+--    writes use the service_role key, which bypasses RLS and is unaffected.
+-- ---------------------------------------------------------------------------
+ALTER TABLE collection_runs ENABLE ROW LEVEL SECURITY;
+
+DO $$
+DECLARE p record;
+BEGIN
+    FOR p IN
+        SELECT policyname FROM pg_policies
+        WHERE schemaname = 'public' AND tablename = 'collection_runs'
+    LOOP
+        EXECUTE format('DROP POLICY IF EXISTS %I ON public.collection_runs', p.policyname);
+    END LOOP;
+
+    -- Recreate the same email-scoped read the other collector tables use.
+    -- Uses auth.jwt() ->> 'email' rather than auth.email(): both work, but the
+    -- jwt form reads the claim the session actually carries, which is what the
+    -- dashboard's own sign-in issues.
+    EXECUTE format(
+        'CREATE POLICY authenticated_read ON public.collection_runs
+           FOR SELECT TO authenticated
+           USING (auth.jwt() ->> ''email'' = %L)',
+        'yaakovytroutai@gmail.com');
+END $$;
+
+-- ---------------------------------------------------------------------------
+-- 2. Narrow the manual-entry policies to writes only.
+--    Dropping the FOR ALL policies and recreating them as FOR INSERT / FOR
+--    UPDATE keeps manual entry working for the signed-in dashboard user while
+--    removing the SELECT side effect that overrode the email-scoped read.
+-- ---------------------------------------------------------------------------
+DROP POLICY IF EXISTS ideas_write ON public.ideas;
+DROP POLICY IF EXISTS costs_write ON public.costs;
+DROP POLICY IF EXISTS angles_write ON public.angles;
+
+-- ---------------------------------------------------------------------------
+-- 3. Restore DELETE, which 004 itself removed.
+--    Narrowing the FOR ALL policies in step 2 to INSERT/UPDATE dropped DELETE
+--    along with the SELECT side effect. The dashboard has a DELETE route per
+--    entity (app/api/{ideas,costs,angles}/[id]/route.ts), so after step 2 a
+--    delete matched zero rows -- RLS hid the row, so Postgres raised no error --
+--    and the route answered {"ok":true} while removing nothing.
+--    Verified on the live database before this fix: SELECT_VISIBLE=1,
+--    UPDATE_ROWS=1, DELETE_ROWS=0 as the allowlisted authenticated user.
+-- ---------------------------------------------------------------------------
+CREATE POLICY ideas_delete ON ideas
+    FOR DELETE TO authenticated USING (auth.jwt() ->> 'email' = 'yaakovytroutai@gmail.com');
+CREATE POLICY costs_delete ON costs
+    FOR DELETE TO authenticated USING (auth.jwt() ->> 'email' = 'yaakovytroutai@gmail.com');
+CREATE POLICY angles_delete ON angles
+    FOR DELETE TO authenticated USING (auth.jwt() ->> 'email' = 'yaakovytroutai@gmail.com');
+
+-- Manual entry from the dashboard UI: the signed-in user may add and edit
+-- their own ideas, costs and angles. Reads stay governed by the
+-- email-scoped authenticated_read policy above.
+CREATE POLICY ideas_insert ON ideas
+    FOR INSERT TO authenticated WITH CHECK (auth.jwt() ->> 'email' = 'yaakovytroutai@gmail.com');
+CREATE POLICY ideas_update ON ideas
+    FOR UPDATE TO authenticated USING (auth.jwt() ->> 'email' = 'yaakovytroutai@gmail.com');
+
+CREATE POLICY costs_insert ON costs
+    FOR INSERT TO authenticated WITH CHECK (auth.jwt() ->> 'email' = 'yaakovytroutai@gmail.com');
+CREATE POLICY costs_update ON costs
+    FOR UPDATE TO authenticated USING (auth.jwt() ->> 'email' = 'yaakovytroutai@gmail.com');
+
+CREATE POLICY angles_insert ON angles
+    FOR INSERT TO authenticated WITH CHECK (auth.jwt() ->> 'email' = 'yaakovytroutai@gmail.com');
+CREATE POLICY angles_update ON angles
+    FOR UPDATE TO authenticated USING (auth.jwt() ->> 'email' = 'yaakovytroutai@gmail.com');
